---
interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  slug: string;
  coverImage?: string;
}

const { title, description, publishDate, slug, coverImage } = Astro.props;
---

<article class="group rounded-xl border border-northbgaccent/20 bg-northbgaccent dark:bg-northbgaccentinvert p-5 shadow-sm transition hover:shadow-md">
  <a href={`/blog/${slug}`} class="block">
    {coverImage && (
      <img
        src={coverImage}
        alt={title}
        class="mb-4 h-48 w-full rounded-lg object-cover"
      />
    )}

    <h2 class="text-xl font-semibold text-northtextaccent dark:text-northtextaccentinvert group-hover:text-neutral-700">
      {title}
    </h2>

    <time class="block mt-1 text-sm text-northtextaccent/50 dark:text-northtextaccentinvert/50 ">
      { publishDate.toLocaleDateString("nl-BE") }
    </time>

    {description && (
      <p class="mt-3 text-northtextaccent/70 dark:text-northtextaccentinvert/70">
        {description}
      </p>
    )}
  </a>
</article>
